# Root gitignore
node_modules/
.vscode/
.idea/
*.log
.DS_Store

# Go backend
backend/bin/
backend/uploads/*
!backend/uploads/.gitkeep
backend/.env
backend/*.exe

# Frontend
frontend/node_modules/
frontend/build/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
